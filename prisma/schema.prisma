// Sanéa Pret database schema (database-design.md). PostgreSQL 18 (D-051).
// Tables and columns are snake_case through @@map and @map (D-056).
// Handwritten SQL (extensions, CHECK constraints, triggers, reference rows)
// lives in the migration files; Prisma does not model it, and its drift check
// does not notice if it is removed (phase-6-plan.md). Every handwritten object
// is listed in apps/api/src/db/handwritten.ts and checked by tests.
//
// Phase 6 tables plus the Phase 7 admin-auth tables, the Phase 8 search
// column and indexes, the Phase 11 guest cart, the Phase 13 enquiries and
// the Phase 15 orders, payments and GST rules (database-design.md §6).

generator client {
  provider               = "prisma-client"
  output                 = "../apps/api/src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

/// Same values as `AdminRole` in @sanea/shared (parity test in apps/api).
enum AdminRole {
  OWNER
  MANAGER
  CATALOGUE_EDITOR
  FULFILMENT

  @@map("admin_role")
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("publish_status")
}

enum ImageRole {
  PRIMARY
  HOVER
  GALLERY

  @@map("image_role")
}

enum SizeChartUnit {
  CM
  IN

  @@map("size_chart_unit")
}

enum StockMovementType {
  RECEIVED
  ADJUSTMENT
  RESERVED
  RELEASED
  SHIPPED
  RETURNED
  RESTOCKED
  CORRECTION

  @@map("stock_movement_type")
}

enum StockReferenceType {
  ORDER
  RESERVATION
  ADMIN
  RETURN

  @@map("stock_reference_type")
}

enum ReservationStatus {
  ACTIVE
  CONVERTED
  RELEASED
  EXPIRED

  @@map("reservation_status")
}

/// The seven block types in system-design.md §7.
/// Same values as `OrderStatus` in @sanea/shared (parity test).
enum OrderStatus {
  PENDING_PAYMENT
  PENDING_CONFIRMATION
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_TO_ORIGIN
  RETURN_REQUESTED
  RETURNED

  @@map("order_status")
}

enum PaymentMethod {
  PREPAID
  COD

  @@map("payment_method")
}

/// system-design.md §6.2.
enum PaymentStatus {
  CREATED
  AUTHORISED
  CAPTURED
  FAILED
  EXPIRED
  REFUND_PENDING
  REFUNDED
  REFUND_FAILED
  PENDING
  COLLECTED
  NOT_COLLECTED

  @@map("payment_status")
}

enum ActorType {
  SYSTEM
  ADMIN
  CUSTOMER
  PROVIDER

  @@map("actor_type")
}

enum RefundStatus {
  PENDING
  REFUNDED
  FAILED

  @@map("refund_status")
}

enum EnquiryStatus {
  NEW
  IN_PROGRESS
  CLOSED

  @@map("enquiry_status")
}

enum ContentBlockType {
  ANNOUNCEMENT_BAR
  HERO_SLIDE
  CATEGORY_PILLS
  PRODUCT_ROW
  TABBED_GRID
  EDITORIAL_BAND
  FOOTER

  @@map("content_block_type")
}

/// What a navigation item points to; URL items carry `url`, the others `targetId`.
enum NavigationTargetType {
  CATEGORY
  COLLECTION
  PRODUCT
  PAGE
  URL

  @@map("navigation_target_type")
}

// ─── Catalogue ──────────────────────────────────────────────────────────────

model Category {
  id             String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name           String
  slug           String        @unique
  parentId       String?       @map("parent_id") @db.Uuid
  position       Int           @default(0)
  status         PublishStatus @default(DRAFT)
  seoTitle       String?       @map("seo_title")
  seoDescription String?       @map("seo_description")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  // Category suggestions (D-081). Needs pg_trgm (handwritten in the migration).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "category_name_trgm_idx")
  @@map("category")
}

model Collection {
  id             String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name           String
  slug           String        @unique
  description    String?
  heroImageId    String?       @map("hero_image_id") @db.Uuid
  status         PublishStatus @default(DRAFT)
  startsAt       DateTime?     @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime?     @map("ends_at") @db.Timestamptz(3)
  seoTitle       String?       @map("seo_title")
  seoDescription String?       @map("seo_description")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  heroImage MediaAsset?         @relation(fields: [heroImageId], references: [id], onDelete: Restrict)
  products  CollectionProduct[]

  @@index([heroImageId])
  @@map("collection")
}

model CollectionProduct {
  collectionId String @map("collection_id") @db.Uuid
  productId    String @map("product_id") @db.Uuid
  position     Int    @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
  @@map("collection_product")
}

model Product {
  id               String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name             String
  slug             String                  @unique
  categoryId       String                  @map("category_id") @db.Uuid
  shortDescription String                  @map("short_description")
  /// Structured rich text (no HTML).
  description      Json
  fabric           String?
  care             String?
  fit              String?
  /// For GST invoices (D-030). No GST rate here: rates come from the rules
  /// model in Phase 15 (D-033).
  hsnCode          String?                 @map("hsn_code")
  sizeChartId      String?                 @map("size_chart_id") @db.Uuid
  status           PublishStatus           @default(DRAFT)
  publishedAt      DateTime?               @map("published_at") @db.Timestamptz(3)
  labels           String[]                @default([])
  seoTitle         String?                 @map("seo_title")
  seoDescription   String?                 @map("seo_description")
  /// Full-text search document (D-081, Q8-1). Maintained only by the
  /// handwritten triggers in the catalogue_search migration; never written by
  /// the API, and read only through reviewed raw SQL.
  searchVector     Unsupported("tsvector") @default(dbgenerated("''::tsvector")) @map("search_vector")
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  category    Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  sizeChart   SizeChart?          @relation(fields: [sizeChartId], references: [id], onDelete: Restrict)
  variants    ProductVariant[]
  images      ProductImage[]
  collections CollectionProduct[]
  enquiries   Enquiry[]
  waClicks    WhatsAppClick[]

  @@index([categoryId])
  @@index([sizeChartId])
  @@index([status, publishedAt(sort: Desc)])
  // Search (D-081). The trigram index needs pg_trgm (handwritten in the migration).
  @@index([searchVector], type: Gin, map: "product_search_vector_idx")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "product_name_trgm_idx")
  @@map("product")
}

model Colour {
  id        String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String
  slug      String @unique
  /// `#RRGGBB`, for UI swatches.
  swatchHex String @map("swatch_hex")
  position  Int    @default(0)

  variants ProductVariant[]
  images   ProductImage[]

  @@map("colour")
}

/// Reference rows only: S, M, L, XL, XXL, Free Size (D-029, D-058), inserted
/// by the migration.
model Size {
  id       String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  label    String @unique
  position Int    @unique

  variants ProductVariant[]

  @@map("size")
}

model SizeChart {
  id        String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String
  unit      SizeChartUnit
  /// Structured measurement rows.
  rows      Json
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@map("size_chart")
}

model ProductVariant {
  id                  String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  productId           String   @map("product_id") @db.Uuid
  colourId            String   @map("colour_id") @db.Uuid
  sizeId              String   @map("size_id") @db.Uuid
  sku                 String   @unique
  /// Integer paise, > 0 (32-bit: at most 2,147,483,647).
  pricePaise          Int      @map("price_paise")
  compareAtPricePaise Int?     @map("compare_at_price_paise")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product      Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  colour       Colour             @relation(fields: [colourId], references: [id], onDelete: Restrict)
  size         Size               @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  inventory    InventoryLevel?
  movements    StockMovement[]
  reservations StockReservation[]
  cartItems    CartItem[]
  orderItems   OrderItem[]
  enquiries    Enquiry[]
  waClicks     WhatsAppClick[]

  @@unique([productId, colourId, sizeId])
  @@index([colourId])
  @@index([sizeId])
  @@map("product_variant")
}

model ProductImage {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  productId    String    @map("product_id") @db.Uuid
  /// Null: the image applies to all colours.
  colourId     String?   @map("colour_id") @db.Uuid
  mediaAssetId String    @map("media_asset_id") @db.Uuid
  alt          String
  position     Int       @default(0)
  role         ImageRole @default(GALLERY)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  colour     Colour?    @relation(fields: [colourId], references: [id], onDelete: Restrict)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@index([productId, position])
  @@index([colourId])
  @@index([mediaAssetId])
  @@map("product_image")
}

model MediaAsset {
  id                String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  storageKey        String   @unique @map("storage_key")
  originalFilename  String   @map("original_filename")
  mimeType          String   @map("mime_type")
  width             Int
  height            Int
  bytes             Int
  /// Derived sizes and formats.
  variants          Json     @default("[]")
  uploadedByAdminId String   @map("uploaded_by_admin_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  uploadedBy  AdminUser      @relation(fields: [uploadedByAdminId], references: [id], onDelete: Restrict)
  images      ProductImage[]
  collections Collection[]

  @@index([uploadedByAdminId])
  @@map("media_asset")
}

// ─── Inventory ──────────────────────────────────────────────────────────────

/// One row per variant. on_hand >= 0, 0 <= reserved <= on_hand (CHECKs).
model InventoryLevel {
  variantId         String   @id @map("variant_id") @db.Uuid
  onHand            Int      @default(0) @map("on_hand")
  reserved          Int      @default(0)
  lowStockThreshold Int      @default(2) @map("low_stock_threshold")
  /// Optimistic concurrency.
  version           Int      @default(0)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@map("inventory_level")
}

/// Append-only: a trigger rejects UPDATE, DELETE and TRUNCATE (D-057).
model StockMovement {
  id            String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  variantId     String              @map("variant_id") @db.Uuid
  type          StockMovementType
  onHandDelta   Int                 @map("on_hand_delta")
  reservedDelta Int                 @default(0) @map("reserved_delta")
  /// Required for ADJUSTMENT and CORRECTION (CHECK).
  reason        String?
  referenceType StockReferenceType? @map("reference_type")
  referenceId   String?             @map("reference_id") @db.Uuid
  actorAdminId  String?             @map("actor_admin_id") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  actorAdmin AdminUser?     @relation(fields: [actorAdminId], references: [id], onDelete: Restrict)

  @@index([variantId, createdAt])
  @@index([actorAdminId])
  @@map("stock_movement")
}

/// The link to orders is added in Phase 15 (D-054).
model StockReservation {
  id        String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  variantId String            @map("variant_id") @db.Uuid
  quantity  Int
  status    ReservationStatus @default(ACTIVE)
  /// Required while ACTIVE, and later than createdAt (CHECK).
  expiresAt DateTime?         @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// Set when the hold belongs to an order (Phase 15, D-054).
  orderId String? @map("order_id") @db.Uuid

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  order   Order?         @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([status, expiresAt])
  @@index([variantId])
  @@index([orderId])
  @@map("stock_reservation")
}

// ─── Guest cart (Phase 11, D-099) ───────────────────────────────────────────

/// A guest cart. Created by the first successful add, never by a read. The
/// token lives only in the `__Host-sp_cart` cookie; only its SHA-256 is stored.
/// No customer link: accounts are deferred (D-034) and add it when scheduled.
model Cart {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// SHA-256 of the cart token: exactly 32 bytes (CHECK).
  tokenHash Bytes    @unique @map("token_hash")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// 30 days after the last write; later than createdAt (CHECK).
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  items CartItem[]

  @@index([expiresAt])
  @@map("cart")
}

/// One variant in a cart. Prices are never stored: every read re-prices.
model CartItem {
  cartId    String   @map("cart_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  /// 1 to 10 (CHECK; D-115, D-099). The configured limit can only be lower.
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@id([cartId, variantId])
  @@index([variantId])
  @@map("cart_item")
}

// ─── Orders and payments (Phase 15) ─────────────────────────────────────────

/// A guest order (database-design.md §3.4). Contact and addresses are
/// snapshots. Totals in paise; total = subtotal − discount + shipping + COD
/// fee (CHECK). Prices include GST, so `taxPaise` is the GST contained in the
/// total, computed from the effective GST rules (0 while none are entered).
model Order {
  id              String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// SP-YYMM-NNNNNN (D-115).
  orderNumber     String        @unique @map("order_number")
  email           String        @db.Citext
  phone           String
  shippingAddress Json          @map("shipping_address")
  billingAddress  Json          @map("billing_address")
  status          OrderStatus
  needsAttention  Boolean       @default(false) @map("needs_attention")
  attentionReason String?       @map("attention_reason")
  paymentMethod   PaymentMethod @map("payment_method")
  subtotalPaise   Int           @map("subtotal_paise")
  discountPaise   Int           @default(0) @map("discount_paise")
  shippingPaise   Int           @map("shipping_paise")
  codFeePaise     Int           @default(0) @map("cod_fee_paise")
  taxPaise        Int           @default(0) @map("tax_paise")
  totalPaise      Int           @map("total_paise")
  currency        String        @default("INR")
  /// Client Idempotency-Key and a hash of the request it came with.
  idempotencyKey  String        @unique @map("idempotency_key") @db.Uuid
  requestHash     String        @map("request_hash")
  /// SHA-256 of the guest's order access token (status page).
  accessTokenHash Bytes         @unique @map("access_token_hash")
  notes           String?
  placedAt        DateTime      @default(now()) @map("placed_at") @db.Timestamptz(3)
  confirmedAt     DateTime?     @map("confirmed_at") @db.Timestamptz(3)
  cancelledAt     DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  items        OrderItem[]
  events       OrderStatusEvent[]
  payments     Payment[]
  shipments    Shipment[]
  reservations StockReservation[]

  @@index([status, placedAt])
  @@index([needsAttention])
  @@index([placedAt])
  @@map("order")
}

/// Snapshot of what was bought, so the order stays right if the product changes.
model OrderItem {
  id             String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId        String  @map("order_id") @db.Uuid
  variantId      String  @map("variant_id") @db.Uuid
  productName    String  @map("product_name")
  variantLabel   String  @map("variant_label")
  sku            String
  unitPricePaise Int     @map("unit_price_paise")
  quantity       Int
  lineTotalPaise Int     @map("line_total_paise")
  /// GST rate in basis points from the effective rule, if one exists (D-033).
  gstRateBps     Int?    @map("gst_rate_bps")
  hsnCode        String? @map("hsn_code")

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([variantId])
  @@map("order_item")
}

/// Every status change, with who made it (system-design.md §5).
model OrderStatusEvent {
  id         String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  actorType  ActorType    @map("actor_type")
  actorId    String?      @map("actor_id")
  note       String?
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@map("order_status_event")
}

model Shipment {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId        String    @map("order_id") @db.Uuid
  courierName    String    @map("courier_name")
  trackingNumber String    @map("tracking_number")
  trackingUrl    String?   @map("tracking_url")
  shippedAt      DateTime  @default(now()) @map("shipped_at") @db.Timestamptz(3)
  deliveredAt    DateTime? @map("delivered_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("shipment")
}

model Payment {
  id                String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId           String        @map("order_id") @db.Uuid
  method            PaymentMethod
  /// `mock` until a live gateway is approved (D-107).
  provider          String
  providerPaymentId String?       @map("provider_payment_id")
  status            PaymentStatus
  amountPaise       Int           @map("amount_paise")
  failureCode       String?       @map("failure_code")
  failureMessage    String?       @map("failure_message")
  /// What the storefront needs to open the provider's payment page; no secrets.
  clientPayload     Json?         @map("client_payload")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  events  PaymentEvent[]
  refunds Refund[]

  @@unique([provider, providerPaymentId])
  @@index([orderId])
  @@index([status, createdAt])
  @@map("payment")
}

/// Raw provider webhooks, stored before processing; one row per provider event.
model PaymentEvent {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  paymentId       String?   @map("payment_id") @db.Uuid
  provider        String
  providerEventId String    @map("provider_event_id")
  type            String
  rawPayload      Json      @map("raw_payload")
  receivedAt      DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt     DateTime? @map("processed_at") @db.Timestamptz(3)
  outcome         String?

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([provider, providerEventId])
  @@index([paymentId])
  @@map("payment_event")
}

model Refund {
  id               String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  paymentId        String       @map("payment_id") @db.Uuid
  amountPaise      Int          @map("amount_paise")
  reason           String
  status           RefundStatus @default(PENDING)
  providerRefundId String?      @map("provider_refund_id")
  /// Null for refunds the system records itself (SR-10).
  createdByAdminId String?      @map("created_by_admin_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  payment   Payment    @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  createdBy AdminUser? @relation(fields: [createdByAdminId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([createdByAdminId])
  @@map("refund")
}

/// Effective-dated GST rules (D-030, D-033). No rates are entered by the
/// system; the Owner enters them after accountant verification (B-14). A rule
/// matches by HSN prefix (empty = any) and by unit price at or below / above
/// a threshold.
model GstRule {
  id               String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  hsnPrefix        String    @default("") @map("hsn_prefix")
  /// Unit price threshold in paise; null means one rate for all prices.
  thresholdPaise   Int?      @map("threshold_paise")
  rateBpsAtOrBelow Int       @map("rate_bps_at_or_below")
  rateBpsAbove     Int?      @map("rate_bps_above")
  effectiveFrom    DateTime  @map("effective_from") @db.Timestamptz(3)
  effectiveTo      DateTime? @map("effective_to") @db.Timestamptz(3)
  note             String?
  createdByAdminId String    @map("created_by_admin_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  createdBy AdminUser @relation(fields: [createdByAdminId], references: [id], onDelete: Restrict)

  @@index([effectiveFrom])
  @@index([createdByAdminId])
  @@map("gst_rule")
}

// ─── Enquiries (Phase 13) ────────────────────────────────────────────────────

/// Website enquiry (database-design.md §3.5, D-054). Consent is required and
/// at least one of email or phone (CHECKs). The IP is stored as a keyed hash.
model Enquiry {
  id               String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  source           String        @default("WEBSITE")
  productId        String?       @map("product_id") @db.Uuid
  variantId        String?       @map("variant_id") @db.Uuid
  name             String
  email            String?       @db.Citext
  /// E.164, +91 mobile.
  phone            String?
  message          String
  consentToContact Boolean       @map("consent_to_contact")
  sourcePath       String        @map("source_path")
  status           EnquiryStatus @default(NEW)
  assignedAdminId  String?       @map("assigned_admin_id") @db.Uuid
  ipHash           String?       @map("ip_hash")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  product       Product?        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  assignedAdmin AdminUser?      @relation(fields: [assignedAdminId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([productId])
  @@index([variantId])
  @@index([assignedAdminId])
  @@map("enquiry")
}

/// Anonymous WhatsApp click-to-chat log (system-design.md §9): no personal data.
model WhatsAppClick {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  productId String?  @map("product_id") @db.Uuid
  variantId String?  @map("variant_id") @db.Uuid
  pagePath  String   @map("page_path")
  /// Random per-browser-session ID, not linked to any person.
  sessionId String   @map("session_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product?        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
  @@index([variantId])
  @@index([createdAt])
  @@map("whatsapp_click")
}

// ─── Admin and security ─────────────────────────────────────────────────────

model AdminUser {
  id                 String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Unique regardless of case (citext).
  email              String    @unique @db.Citext
  name               String
  passwordHash       String    @map("password_hash")
  role               AdminRole
  /// TOTP secret, AES-256-GCM encrypted by the API (D-065). 2FA is
  /// mandatory for all four roles (D-032): an active admin must have it (CHECK).
  mfaSecretEncrypted Bytes?    @map("mfa_secret_encrypted")
  /// Which MFA_ENCRYPTION_KEY version encrypted the secret (rotation).
  mfaKeyVersion      Int?      @map("mfa_key_version")
  mfaEnabledAt       DateTime? @map("mfa_enabled_at") @db.Timestamptz(3)
  /// Last accepted TOTP time step; a code cannot be reused (D-064).
  mfaLastUsedStep    Int?      @map("mfa_last_used_step")
  isActive           Boolean   @default(true) @map("is_active")
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(3)
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions        AdminSession[]
  auditEntries    AuditLog[]
  mediaUploads    MediaAsset[]
  stockMovements  StockMovement[]
  publishedBlocks ContentBlock[]
  verifiedPages   Page[]
  settingUpdates  StoreSetting[]
  recoveryCodes   AdminRecoveryCode[]
  invitesSent     AdminInvite[]       @relation("InviteSentBy")
  enquiries       Enquiry[]
  refunds         Refund[]
  gstRules        GstRule[]
  resetInvites    AdminInvite[]       @relation("InviteForAdmin")

  @@map("admin_user")
}

/// Only the SHA-256 hash of the session token is stored (32 bytes, CHECK).
model AdminSession {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  adminUserId String   @map("admin_user_id") @db.Uuid
  tokenHash   Bytes    @unique @map("token_hash")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt  DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)
  ipHash      String?  @map("ip_hash")
  userAgent   String?  @map("user_agent")

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
  @@map("admin_session")
}

/// Single-use invite or reset link (D-070, D-071). Only the SHA-256 hash of
/// the token is stored. `adminUserId` is set for a reset of an existing admin;
/// a new admin is created when a fresh invite is accepted. The TOTP secret for
/// enrolment is generated before acceptance and kept encrypted here.
model AdminInvite {
  id                   String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email                String    @db.Citext
  role                 AdminRole
  tokenHash            Bytes     @unique @map("token_hash")
  adminUserId          String?   @map("admin_user_id") @db.Uuid
  /// Null only for the first Owner created by the CLI (D-069).
  invitedByAdminId     String?   @map("invited_by_admin_id") @db.Uuid
  pendingMfaSecret     Bytes?    @map("pending_mfa_secret_encrypted")
  pendingMfaKeyVersion Int?      @map("pending_mfa_key_version")
  expiresAt            DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt           DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt            DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  adminUser AdminUser? @relation("InviteForAdmin", fields: [adminUserId], references: [id], onDelete: Cascade)
  invitedBy AdminUser? @relation("InviteSentBy", fields: [invitedByAdminId], references: [id], onDelete: Restrict)

  @@index([email])
  @@index([adminUserId])
  @@index([invitedByAdminId])
  @@map("admin_invite")
}

/// One-time MFA recovery codes (D-071); only SHA-256 hashes are stored.
model AdminRecoveryCode {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  adminUserId String    @map("admin_user_id") @db.Uuid
  codeHash    Bytes     @unique @map("code_hash")
  usedAt      DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@map("admin_recovery_code")
}

/// Append-only: a trigger rejects UPDATE, DELETE and TRUNCATE (D-057).
model AuditLog {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  actorAdminId String   @map("actor_admin_id") @db.Uuid
  /// For example `product.update`.
  action       String
  entityType   String   @map("entity_type")
  entityId     String?  @map("entity_id")
  before       Json?
  after        Json?
  ipHash       String?  @map("ip_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actorAdmin AdminUser @relation(fields: [actorAdminId], references: [id], onDelete: Restrict)

  @@index([actorAdminId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("audit_log")
}

// ─── Content ────────────────────────────────────────────────────────────────

/// Typed blocks with draft and published versions; no raw HTML (D-109).
model ContentBlock {
  id                 String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// For example `home.hero`.
  key                String           @unique
  type               ContentBlockType
  draft              Json
  published          Json?
  publishedAt        DateTime?        @map("published_at") @db.Timestamptz(3)
  publishedByAdminId String?          @map("published_by_admin_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  publishedBy AdminUser? @relation(fields: [publishedByAdminId], references: [id], onDelete: Restrict)

  @@index([publishedByAdminId])
  @@map("content_block")
}

/// Pages that require verification (Rehma Foundation) cannot be published
/// until verified (CHECK).
model Page {
  id                   String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug                 String        @unique
  title                String
  draftBody            Json          @map("draft_body")
  publishedBody        Json?         @map("published_body")
  seoTitle             String?       @map("seo_title")
  seoDescription       String?       @map("seo_description")
  status               PublishStatus @default(DRAFT)
  requiresVerification Boolean       @default(false) @map("requires_verification")
  verifiedByAdminId    String?       @map("verified_by_admin_id") @db.Uuid
  verifiedAt           DateTime?     @map("verified_at") @db.Timestamptz(3)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  verifiedBy AdminUser? @relation(fields: [verifiedByAdminId], references: [id], onDelete: Restrict)

  @@index([verifiedByAdminId])
  @@map("page")
}

model NavigationItem {
  id         String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// `HEADER`, `CATEGORY_PILLS` or a footer menu (system-design.md).
  menu       String
  label      String
  targetType NavigationTargetType @map("target_type")
  targetId   String?              @map("target_id") @db.Uuid
  url        String?
  position   Int                  @default(0)
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([menu, position])
  @@map("navigation_item")
}

/// WhatsApp number, contact details, COD and shipping rules.
model StoreSetting {
  key              String   @id
  value            Json
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedByAdminId String?  @map("updated_by_admin_id") @db.Uuid

  updatedBy AdminUser? @relation(fields: [updatedByAdminId], references: [id], onDelete: Restrict)

  @@index([updatedByAdminId])
  @@map("store_setting")
}
