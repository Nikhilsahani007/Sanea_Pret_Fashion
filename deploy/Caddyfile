# Caddy in front of the API (phase-19-plan.md §3). TLS certificates are
# obtained and renewed automatically. SHOP_DOMAIN and ADMIN_DOMAIN come from
# the environment (deploy/compose.production.yaml).

(security) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

{$SHOP_DOMAIN} {
	import security
	encode zstd gzip

	# Link-preview and search bots get the server-made meta (D-193, D-194).
	@bots {
		header_regexp User-Agent (?i)(googlebot|bingbot|duckduckbot|yandex|baiduspider|facebookexternalhit|facebot|twitterbot|linkedinbot|whatsapp|slackbot|telegrambot|discordbot|pinterest|applebot)
		not path /api/* /media/* /assets/* /robots.txt /sitemap.xml
	}
	handle @bots {
		rewrite * /api/v1/seo/preview?path={path}
		reverse_proxy api:4000
	}

	handle /api/* {
		reverse_proxy api:4000
	}
	handle /robots.txt {
		rewrite * /api/v1/seo/robots.txt
		reverse_proxy api:4000
	}
	handle /sitemap.xml {
		rewrite * /api/v1/seo/sitemap.xml
		reverse_proxy api:4000
	}
	# Public image derivatives only (MEDIA_PUBLIC_BASE_URL=https://<shop>/media/).
	handle_path /media/* {
		root * /srv/media/public
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle /assets/* {
		root * /srv/storefront
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		root * /srv/storefront
		try_files {path} /index.html
		file_server
	}
}

{$ADMIN_DOMAIN} {
	import security
	encode zstd gzip
	handle /api/* {
		reverse_proxy api:4000
	}
	handle {
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}
}
