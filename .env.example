# Copy to .env for local development. Never commit .env.
# Each phase adds the variables it needs here, by name, with no real values.

# Phase 3
NODE_ENV=development

# Phase 5: API (apps/api). Names only; set real values in your local .env.
# HOST and PORT default to 127.0.0.1 and 4000. Origins are exact (no path);
# production requires https. CSRF_SECRET must be at least 32 random characters.
HOST=
PORT=
LOG_LEVEL=
STOREFRONT_ORIGIN=
ADMIN_ORIGIN=
CSRF_SECRET=
TRUST_PROXY=

# Phase 6: local PostgreSQL 18 (compose.yaml, D-051). Names only.
# POSTGRES_PASSWORD is required by compose.yaml and has no default.
# POSTGRES_PORT is the loopback host port (default 5433).
# DATABASE_URL format: postgresql://sanea:<POSTGRES_PASSWORD>@127.0.0.1:5433/sanea_dev
POSTGRES_PASSWORD=
POSTGRES_PORT=
DATABASE_URL=
# Optional: database name created by compose.yaml (default sanea_dev).
POSTGRES_DB=
# Optional: a separate empty database, only for `prisma migrate diff --from-migrations`.
SHADOW_DATABASE_URL=
# Integration tests (`npm run test:integration`, D-059): loopback only, and the
# database name must start with sanea_test. Example path: 127.0.0.1:5433/sanea_test
TEST_DATABASE_URL=

# Phase 7: admin authentication (D-065, D-073). Names only; generate locally.
# The API now requires DATABASE_URL at start-up.
# MFA_ENCRYPTION_KEY: 32 random bytes, base64 (for example
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))").
# MFA_ENCRYPTION_KEY_VERSION: integer, default 1; stored with each secret.
# IP_HASH_KEY: at least 32 random characters.
MFA_ENCRYPTION_KEY=
MFA_ENCRYPTION_KEY_VERSION=
IP_HASH_KEY=
