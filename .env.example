# Copy to .env for local development. Never commit .env.
# Each phase adds the variables it needs here, by name, with no real values.

# Phase 3
NODE_ENV=development

# Phase 5: API (apps/api). Names only; set real values in your local .env.
# HOST and PORT default to 127.0.0.1 and 4000. Origins are exact (no path);
# production requires https. CSRF_SECRET must be at least 32 random characters.
HOST=
PORT=
LOG_LEVEL=
STOREFRONT_ORIGIN=
ADMIN_ORIGIN=
CSRF_SECRET=
TRUST_PROXY=

# Phase 6: local PostgreSQL 18 (compose.yaml, D-051). Names only.
# POSTGRES_PASSWORD is required by compose.yaml and has no default.
# POSTGRES_PORT is the loopback host port (default 5433).
# DATABASE_URL format: postgresql://sanea:<POSTGRES_PASSWORD>@127.0.0.1:5433/sanea_dev
POSTGRES_PASSWORD=
POSTGRES_PORT=
DATABASE_URL=
# Optional: database name created by compose.yaml (default sanea_dev).
POSTGRES_DB=
# Optional: a separate empty database, only for `prisma migrate diff --from-migrations`.
SHADOW_DATABASE_URL=
# Integration tests (`npm run test:integration`, D-059): loopback only, and the
# database name must start with sanea_test. Example path: 127.0.0.1:5433/sanea_test
TEST_DATABASE_URL=

# Phase 7: admin authentication (D-065, D-073). Names only; generate locally.
# The API now requires DATABASE_URL at start-up.
# MFA_ENCRYPTION_KEY: 32 random bytes, base64 (for example
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))").
# MFA_ENCRYPTION_KEY_VERSION: integer, default 1; stored with each secret.
# IP_HASH_KEY: at least 32 random characters.
MFA_ENCRYPTION_KEY=
MFA_ENCRYPTION_KEY_VERSION=
IP_HASH_KEY=

# Phase 8: media storage (D-080, Q8-9). Names only.
# MEDIA_STORAGE_DIR: local folder for development storage; private originals and
#   public derivatives are kept in separate subfolders. Must be outside the repository.
# MEDIA_PUBLIC_BASE_URL: base URL that public derivative images are served from
#   (the development image server on loopback; a CDN in production). Never the API origin.
MEDIA_STORAGE_DIR=
MEDIA_PUBLIC_BASE_URL=
# MEDIA_UPLOAD_QUEUE_WAITING: uploads allowed to wait per API process while one is
#   processed (default 2).
MEDIA_UPLOAD_QUEUE_WAITING=

# Phase 8: admin app (apps/admin). Optional; names only.
# ADMIN_API_URL: where the admin dev and preview servers on http://localhost:5174
#   proxy /api (default http://127.0.0.1:4000). The API needs
#   ADMIN_ORIGIN=http://localhost:5174.
# End-to-end tests (npx playwright test) use TEST_DATABASE_URL above and create
#   their own sanea_test_e2e database; their other secrets are generated per run.
ADMIN_API_URL=

# Phase 9: stock reservations (SR-3, D-090). Optional; names only.
# RESERVATION_TTL_MINUTES: how long checkout holds stock, whole minutes 5 to 60
#   (default 15). Expired holds are released every minute.
RESERVATION_TTL_MINUTES=

# Phase 11: guest cart (D-099). Optional; names only.
# CART_MAX_LINE_QUANTITY: the most units of one variant in a cart, whole number
#   1 to 10 (default 10; the database ceiling is 10).
CART_MAX_LINE_QUANTITY=

# Phase 15: payments (system-design.md §6, D-107). Optional; names only.
# PAYMENT_PROVIDER: mock (development and tests; refused in production),
#   phonepe (PhonePe Payment Gateway, D-195) or none (no online payment; the
#   production default). Default: mock outside production.
# MOCK_PAYMENT_SECRET: signs mock webhooks, at least 32 characters; leave empty
#   for a random per-process secret. Never a live gateway key.
PAYMENT_PROVIDER=
MOCK_PAYMENT_SECRET=

# Phase 18: PhonePe (D-195). Required when PAYMENT_PROVIDER=phonepe.
# PHONEPE_ENV: sandbox (default) or production. production takes real money:
#   it needs NODE_ENV=production and PHONEPE_LIVE_APPROVED=true, set only after
#   the owner approves the live gateway (index Phase 18 gate).
# PHONEPE_CLIENT_ID, PHONEPE_CLIENT_SECRET, PHONEPE_CLIENT_VERSION: from the
#   PhonePe business dashboard (API keys). Version defaults to 1.
# PHONEPE_WEBHOOK_USERNAME, PHONEPE_WEBHOOK_PASSWORD: the webhook credentials
#   you set on the dashboard; the webhook URL is
#   <API origin>/api/v1/webhooks/payments/phonepe.
PHONEPE_ENV=
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=
PHONEPE_LIVE_APPROVED=
